PORT=5050
NODE_ENV=development

# PostgreSQL Connection URL (e.g. Render, Railway, Neon, AWS RDS)
DATABASE_URL=postgresql://funfillersdb_user:YOUR_PASSWORD@dpg-xxxxxx.oregon-postgres.render.com/funfillersdb?sslmode=require

# Individual Connection Fallbacks
DB_HOST=dpg-xxxxxx.oregon-postgres.render.com
DB_PORT=5432
DB_USER=funfillersdb_user
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=funfillersdb
DB_SSLMODE=require

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d

CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
